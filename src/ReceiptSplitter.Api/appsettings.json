{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "BlobServiceUri": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Bills": {
    "RetentionDays": 30,
    "MaxPeople": 50,
    "MaxReceipts": 10,
    "MaxLinesPerReceipt": 200,
    "MaxUnitsPerLine": 100,
    "MaxActivity": 100
  },
  "NotFound": {
    "Limit": 20,
    "WindowMinutes": 10
  },
  "RateLimits": {
    "CreatePerHour": 10,
    "WritesPerMinute": 60,
    "ReadsPerMinute": 120,
    "CreatePerDay": 500
  },
  "Scans": {
    "DailyCap": 15,
    "PerIpPerHour": 3,
    "MaxBytes": 4194304,
    "UseSample": false
  }
}
