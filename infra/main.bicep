// Everything Receipt Splitter runs on, in one resource group. Deployed by the ci-cd workflow
// (target=infra, and again by target=api with a new image). See infra/README.md.

@description('Region for everything except the Static Web App.')
param location string = resourceGroup().location

@description('Static Web Apps is offered only in centralus, eastus2, westus2, westeurope and eastasia (checked November 2026).')
param webLocation string = 'eastasia'

@description('Prefix for resource names.')
param namePrefix string = 'receipt-splitter'

@description('API container image. Empty runs a public placeholder until the first release.')
param apiImage string = ''

@description('Monthly budget in the billing currency.')
param budgetAmount int = 1

@description('First day of the month the budget starts counting from.')
param budgetStartDate string

@description('Who gets the budget alert emails.')
param budgetAlertEmail string

@description('owner/repo on GitHub. The stop runbook is published from its raw file there.')
param githubRepo string

@description('Commit that the stop runbook is published from. infra/deploy.sh sets it.')
param runbookCommit string

@description('Create the stop webhook and its action group. infra/deploy.sh sets it when the action group is missing.')
param createStopWebhook bool = false

@secure()
@description('Address for the new stop webhook, generated by infra/deploy.sh. Only used with createStopWebhook.')
param stopWebhookUri string = ''

// Storage and Document Intelligence names are global, so they get a suffix unique to this group.
var suffix = uniqueString(resourceGroup().id)

module storage 'modules/storage.bicep' = {
  name: 'storage'
  params: {
    location: location
    name: 'rsbills${suffix}'
  }
}

module docIntel 'modules/docintel.bicep' = {
  name: 'docintel'
  params: {
    location: location
    name: '${namePrefix}-scan-${suffix}'
  }
}

module web 'modules/staticwebapp.bicep' = {
  name: 'staticwebapp'
  params: {
    location: webLocation
    name: '${namePrefix}-web'
  }
}

module api 'modules/containerapp.bicep' = {
  name: 'containerapp'
  params: {
    location: location
    environmentName: '${namePrefix}-env'
    appName: '${namePrefix}-api'
    image: apiImage
    blobEndpoint: storage.outputs.blobEndpoint
    docIntelEndpoint: docIntel.outputs.endpoint
    webOrigin: web.outputs.origin
  }
}

module roles 'modules/roles.bicep' = {
  name: 'roles'
  params: {
    principalId: api.outputs.principalId
    storageName: storage.outputs.name
    docIntelName: docIntel.outputs.name
  }
}

module killSwitch 'modules/killswitch.bicep' = {
  name: 'killswitch'
  params: {
    location: location
    accountName: '${namePrefix}-automation'
    actionGroupName: '${namePrefix}-api-stop'
    appName: api.outputs.name
    runbookUri: 'https://raw.githubusercontent.com/${githubRepo}/${runbookCommit}/infra/runbooks/stop-api.ps1'
    createWebhook: createStopWebhook
    webhookUri: stopWebhookUri
  }
}

module budget 'modules/budget.bicep' = {
  name: 'budget'
  params: {
    name: '${namePrefix}-monthly'
    amount: budgetAmount
    startDate: budgetStartDate
    alertEmail: budgetAlertEmail
    stopActionGroupId: killSwitch.outputs.actionGroupId
  }
}

output webUrl string = web.outputs.origin
output apiUrl string = 'https://${api.outputs.fqdn}'
