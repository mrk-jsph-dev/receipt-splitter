# Build-time settings for the web app. Copy to .env.local only if you need to change them.
# Locally both can stay empty: Vite proxies /api to http://localhost:5080.

# The API's address in production. The deploy workflow sets it.
VITE_API_BASE_URL=

# "true" turns automatic polling back on. Off by default: bills sync on Refresh.
VITE_AUTO_SYNC=
